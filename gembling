<!DOCTYPE html>
<html lang="sk">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>GRAM Casino</title>
    <script src="https://telegram.org/js/telegram-web-app.js"></script>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            -webkit-tap-highlight-color: transparent;
        }

        body {
            background: linear-gradient(135deg, #0f0c29, #302b63, #24243e);
            color: white;
            min-height: 100vh;
            padding: 16px;
            overflow-x: hidden;
        }

        .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            background: rgba(255,255,255,0.08);
            padding: 14px 18px;
            border-radius: 16px;
            margin-bottom: 20px;
            backdrop-filter: blur(10px);
        }

        .balance {
            font-size: 20px;
            font-weight: 700;
        }

        .balance span {
            color: #00ff9d;
        }

        .level {
            background: #ffd700;
            color: #000;
            padding: 4px 12px;
            border-radius: 20px;
            font-weight: 700;
            font-size: 14px;
        }

        .title {
            text-align: center;
            font-size: 28px;
            font-weight: 800;
            margin: 10px 0 25px;
            background: linear-gradient(to right, #ffd700, #ff6b00);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .menu {
            display: grid;
            gap: 14px;
        }

        .btn {
            background: linear-gradient(90deg, #6a11cb, #2575fc);
            border: none;
            color: white;
            padding: 18px;
            border-radius: 16px;
            font-size: 18px;
            font-weight: 600;
            cursor: pointer;
            transition: transform 0.15s, box-shadow 0.15s;
            box-shadow: 0 6px 20px rgba(0,0,0,0.3);
        }

        .btn:active {
            transform: scale(0.97);
        }

        .btn.gold {
            background: linear-gradient(90deg, #f7971e, #ffd200);
            color: #000;
        }

        .btn.red {
            background: linear-gradient(90deg, #eb3349, #f45c43);
        }

        .screen {
            display: none;
        }

        .screen.active {
            display: block;
        }

        /* Koleso */
        .wheel-container {
            position: relative;
            width: 280px;
            height: 280px;
            margin: 30px auto;
        }

        .wheel {
            width: 100%;
            height: 100%;
            border-radius: 50%;
            background: conic-gradient(
                #ff0000 0deg 45deg,
                #ff9900 45deg 90deg,
                #ffff00 90deg 135deg,
                #00ff00 135deg 180deg,
                #00ffff 180deg 225deg,
                #0000ff 225deg 270deg,
                #9900ff 270deg 315deg,
                #ff00ff 315deg 360deg
            );
            border: 8px solid #ffd700;
            transition: transform 4s cubic-bezier(0.2, 0.8, 0.3, 1);
            box-shadow: 0 0 30px rgba(255,215,0,0.4);
        }

        .pointer {
            position: absolute;
            top: -15px;
            left: 50%;
            transform: translateX(-50%);
            width: 0;
            height: 0;
            border-left: 15px solid transparent;
            border-right: 15px solid transparent;
            border-top: 30px solid #ffd700;
            z-index: 10;
        }

        .result {
            text-align: center;
            font-size: 22px;
            font-weight: 700;
            margin: 20px 0;
            min-height: 60px;
        }

        .back-btn {
            background: rgba(255,255,255,0.15);
            margin-top: 20px;
        }

        .profile-box {
            background: rgba(255,255,255,0.08);
            padding: 20px;
            border-radius: 16px;
            margin-bottom: 20px;
            line-height: 1.8;
        }

        .wallet {
            word-break: break-all;
            font-size: 13px;
            color: #aaa;
            margin-top: 8px;
        }
    </style>
</head>
<body>
    <div class="header">
        <div class="balance">💰 <span id="balance">1.0000</span> GRAM</div>
        <div class="level">LVL <span id="level">1</span></div>
    </div>

    <div class="title">GRAM CASINO</div>

    <!-- HLAVNÉ MENU -->
    <div id="menu" class="screen active">
        <div class="menu">
            <button class="btn gold" onclick="showScreen('wheel')">🎰 Koleso Šťastia<br><small>0.01 GRAM</small></button>
            <button class="btn" onclick="showScreen('minigames')">🎲 Mini Hry</button>
            <button class="btn" onclick="showScreen('profile')">👤 Profil & Wallet</button>
        </div>
    </div>

    <!-- KOLESO -->
    <div id="wheel" class="screen">
        <div class="wheel-container">
            <div class="pointer"></div>
            <div class="wheel" id="wheelEl"></div>
        </div>
        <div class="result" id="wheelResult">Klikni na SPIN</div>
        <button class="btn gold" onclick="spinWheel()" id="spinBtn">SPIN (0.01 GRAM)</button>
        <button class="btn back-btn" onclick="showScreen('menu')">← Späť</button>
    </div>

    <!-- MINI HRY -->
    <div id="minigames" class="screen">
        <div class="menu">
            <button class="btn" onclick="playCoinFlip()">🪙 Coin Flip (0.02 GRAM)</button>
            <button class="btn" onclick="playDice()">🎲 Dice (0.03 GRAM)</button>
            <button class="btn back-btn" onclick="showScreen('menu')">← Späť</button>
        </div>
        <div class="result" id="miniResult" style="margin-top:30px;"></div>
    </div>

    <!-- PROFIL -->
    <div id="profile" class="screen">
        <div class="profile-box">
            <div>⭐ Level: <strong id="p-level">1</strong></div>
            <div>✨ XP: <strong id="p-xp">0</strong> / <span id="p-next">100</span></div>
            <div>💰 Balance: <strong id="p-balance">1.0000</strong> GRAM</div>
            <div class="wallet">🔗 Wallet: <span id="wallet">nepripojený</span></div>
        </div>
        <button class="btn" onclick="connectWallet()">🔗 Pripojiť Wallet</button>
        <button class="btn back-btn" onclick="showScreen('menu')">← Späť</button>
    </div>

    <script>
        // Telegram WebApp
        const tg = window.Telegram.WebApp;
        tg.expand();
        tg.ready();
        tg.setHeaderColor('#0f0c29');
        tg.setBackgroundColor('#0f0c29');

        // Dáta hráča
        let player = {
            balance: 1.0,
            level: 1,
            xp: 0,
            wallet: null
        };

        // Načítanie z localStorage
        const saved = localStorage.getItem('gramCasino');
        if (saved) player = JSON.parse(saved);

        function save() {
            localStorage.setItem('gramCasino', JSON.stringify(player));
            updateUI();
        }

        function updateUI() {
            document.getElementById('balance').textContent = player.balance.toFixed(4);
            document.getElementById('level').textContent = player.level;
            document.getElementById('p-level').textContent = player.level;
            document.getElementById('p-xp').textContent = player.xp;
            document.getElementById('p-next').textContent = player.level * 100;
            document.getElementById('p-balance').textContent = player.balance.toFixed(4);
            document.getElementById('wallet').textContent = player.wallet || 'nepripojený';
        }

        function showScreen(id) {
            document.querySelectorAll('.screen').forEach(s => s.classList.remove('active'));
            document.getElementById(id).classList.add('active');
            updateUI();
        }

        function addXP(amount) {
            player.xp += amount;
            while (player.xp >= player.level * 100) {
                player.xp -= player.level * 100;
                player.level++;
                tg.showAlert(`🆙 LEVEL UP! Teraz si level ${player.level}`);
            }
        }

        // ===== KOLESO ŠŤASTIA =====
        let spinning = false;
        function spinWheel() {
            if (spinning) return;
            if (player.balance < 0.01) {
                tg.showAlert('❌ Nemáš dosť GRAM!');
                return;
            }

            spinning = true;
            player.balance -= 0.01;
            addXP(5);
            document.getElementById('spinBtn').disabled = true;

            const prizes = [0, 0.005, 0.01, 0.02, 0.05, 0.1, 0.25, 1.0];
            const weights = [35, 25, 18, 12, 7, 2.5, 0.4, 0.1];
            const total = weights.reduce((a,b)=>a+b);
            let rand = Math.random() * total;
            let win = 0;
            for (let i = 0; i < weights.length; i++) {
                if (rand < weights[i]) { win = prizes[i]; break; }
                rand -= weights[i];
            }

            const degrees = 1800 + Math.floor(Math.random() * 360);
            document.getElementById('wheelEl').style.transform = `rotate(${degrees}deg)`;

            setTimeout(() => {
                player.balance += win;
                let msg = win === 0 ? '😢 Nič...' :
                          win >= 0.25 ? `🔥 JACKPOT! +${win} GRAM` :
                          `🎉 +${win} GRAM`;
                document.getElementById('wheelResult').textContent = msg;
                spinning = false;
                document.getElementById('spinBtn').disabled = false;
                save();
            }, 4200);
        }

        // ===== MINI HRY =====
        function playCoinFlip() {
            if (player.balance < 0.02) return tg.showAlert('❌ Nemáš dosť GRAM!');
            player.balance -= 0.02;
            addXP(8);
            const win = Math.random() < 0.48;
            const amount = win ? 0.039 : 0;
            player.balance += amount;
            document.getElementById('miniResult').textContent = win ? 
                `🪙 Hlava! +0.039 GRAM` : `🪙 Orel... Prehral si`;
            save();
        }

        function playDice() {
            if (player.balance < 0.03) return tg.showAlert('❌ Nemáš dosť GRAM!');
            player.balance -= 0.03;
            addXP(10);
            const roll = Math.floor(Math.random() * 6) + 1;
            let amount = 0;
            let msg = '';
            if (roll === 6) { amount = 0.15; msg = `🔥 6! +0.15 GRAM`; }
            else if (roll >= 4) { amount = 0.054; msg = `🎉 ${roll} +0.054 GRAM`; }
            else { msg = `😢 ${roll} - prehral si`; }
            player.balance += amount;
            document.getElementById('miniResult').textContent = msg;
            save();
        }

        // ===== WALLET =====
        function connectWallet() {
            if (player.wallet) {
                tg.showAlert('Wallet je už pripojený');
                return;
            }
            // Simulácia (v reálnom projekte tu dáš TON Connect)
            const fake = 'UQ' + Array.from({length:46},()=>"ABCDEFGHJKLMNPQRSTUVWXYZ23456789"[Math.floor(Math.random()*32)]).join('');
            player.wallet = fake;
            save();
            tg.showAlert('✅ Wallet pripojený!');
        }

        // Štart
        updateUI();
    </script>
</body>
</html>